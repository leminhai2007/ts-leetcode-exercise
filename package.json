{
    "name": "ts-leetcode-exercise",
    "version": "1.0.0",
    "description": "LeetCode exercises in TypeScript with Mocha tests",
    "license": "MIT",
    "main": "dist/index.js",
    "scripts": {
        "build": "tsc",
        "test": "mocha --require ts-node/register test/**/*.ts",
        "test:easy": "yarn test --grep '@easy'",
        "test:medium": "yarn test --grep '@medium'",
        "test:hard": "yarn test --grep '@hard'",
        "test:tag": "yarn test --grep",
        "lint": "eslint src/**/*.ts test/**/*.ts",
        "lint:fix": "eslint src/**/*.ts test/**/*.ts --fix",
        "format": "prettier --write .",
        "prepare": "husky install"
    },
    "devDependencies": {
        "@types/chai": "^4.3.5",
        "@types/mocha": "^10.0.1",
        "@types/node": "^20.5.7",
        "@typescript-eslint/eslint-plugin": "^8.46.4",
        "@typescript-eslint/parser": "^8.46.4",
        "chai": "^4.3.10",
        "eslint": "^9.39.1",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.4",
        "husky": "^8.0.0",
        "mocha": "^10.2.0",
        "prettier": "^3.6.2",
        "ts-node": "^10.9.1",
        "typescript": "^5.2.2"
    }
}
